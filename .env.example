# Copy to .env and fill in the values you need. Never commit .env.

# Google Gemini API key for the AI bio / bullet / skills assistant.
# Without it the AI endpoints return built-in template text.
GEMINI_API_KEY=

# Password for the admin dashboard (sign in as admin@portfoliomaldives.mv).
# Required in production. In development it defaults to "admin".
ADMIN_PASSWORD=

# Optional: secret used to sign admin session tokens. If unset, a random
# secret is generated at startup and admin sessions end when the server restarts.
ADMIN_TOKEN_SECRET=

# Optional: where published portfolios and inquiries are stored (default ./data).
DATA_DIR=

# Optional: HTTP port (default 3000).
PORT=

# Optional: Supabase project for the shared job-positions registry.
# Without these the position picker shows no preset positions.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
